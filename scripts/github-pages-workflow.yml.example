# Optional: an alternative to scripts/deploy.sh, using GitHub Actions.
# To switch to it:
#   gh auth refresh -h github.com -s workflow
#   mkdir -p .github/workflows
#   cp scripts/github-pages-workflow.yml.example .github/workflows/deploy.yml
#   git add -A && git commit -m "Deploy via Actions" && git push
# Then set Pages source to "GitHub Actions" in the repository settings.

name: Deploy to GitHub Pages

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

# Let a running deploy finish; never run two at once.
concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm

      - run: npm ci

      # A project site is served from /<repo>/, so the base path must match the
      # repository name. Taken from the repo itself so renaming it still works.
      - name: Build
        env:
          VITE_BASE: /${{ github.event.repository.name }}/
        run: npm run build

      - uses: actions/upload-pages-artifact@v3
        with:
          path: dist

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v4
